# Copy to .env.local and fill in. Never commit real values.

# Public
# REQUIRED in production: the public origin, e.g. https://www.example.pt. The booking API only accepts
# requests whose Origin matches it (www and apex are treated as the same site). If it is missing or
# localhost in production every booking is rejected with 403 and a warning is logged.
NEXT_PUBLIC_SITE_URL=
# Optional extra allowed origins for the booking API, comma separated (e.g. a preview domain).
ALLOWED_ORIGINS=
NEXT_PUBLIC_DRIVER_WHATSAPP_NUMBER=351966167435

# Search engine indexing. Leave unset or "off" until launch; set to "on" in production only
# when the real content is in (otherwise robots.txt blocks everything and pages are noindex).
SITE_INDEXING=off

# Database
MONGODB_URI=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_BOOKINGS_TO=
# Keep false until a captcha (Turnstile) or a shared rate limit (Upstash) exists: otherwise the form can be
# abused to send mail to arbitrary addresses. The copy never includes the free-text notes.
EMAIL_CUSTOMER_COPY_ENABLED=false

# WhatsApp Business notifications (optional, off by default)
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=
# Number that receives the notification (international format). Must differ from the business number that sends it.
WHATSAPP_DRIVER_TO=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=novo_pedido_reserva
WHATSAPP_TEMPLATE_LANG=pt_PT

# Rate limiting (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Privacy: secret salt for hashing IPs. REQUIRED in production: without it no IP hash is stored and
# rate-limit keys use a random per-instance salt (a warning is logged).
IP_HASH_SALT=

# Bot protection (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
