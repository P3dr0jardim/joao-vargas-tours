# Copy to .env.local and fill in. Never commit real values.

# Public
# REQUIRED in production: the public origin, e.g. https://www.example.pt. The admin API only accepts
# writes whose Origin matches it (www and apex are treated as the same site).
NEXT_PUBLIC_SITE_URL=
# Optional extra allowed origins for the admin API, comma separated (e.g. a preview domain).
ALLOWED_ORIGINS=
# Number every "WhatsApp" button opens (international format, digits only). There is no booking
# form: tours and transfers are requested by WhatsApp (prefilled message) or by phone.
NEXT_PUBLIC_DRIVER_WHATSAPP_NUMBER=351966167435

# Search engine indexing. Leave unset or "off" until launch; set to "on" in production only
# when the real content is in (otherwise robots.txt blocks everything and pages are noindex).
SITE_INDEXING=off

# Database
MONGODB_URI=

# Admin panel (/admin). Needs MONGODB_URI too. A random string of at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs every admin out. Create the account with: npm run admin:create -- you@example.pt
ADMIN_SESSION_SECRET=
